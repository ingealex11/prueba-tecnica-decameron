# -----------------------------------------------------------------------------
# Configuración de producción · Hostinger Cloud + Neon PostgreSQL
# -----------------------------------------------------------------------------
# Copiar como .env en el servidor y rellenar los valores marcados con <>.
# Este archivo NO contiene secretos; el .env real nunca se versiona.

APP_NAME="Decameron Hotels API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-decameron.<tu-dominio>

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Base de datos: Neon (PostgreSQL gestionado, capa gratuita) --------------
# Los valores salen de la cadena de conexión que muestra Neon en su panel:
#   postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=<ep-xxxx-xxxx.us-east-2.aws.neon.tech>
DB_PORT=5432
DB_DATABASE=<neondb>
DB_USERNAME=<usuario>
DB_PASSWORD=<contraseña>
# Neon exige conexión cifrada.
DB_SSLMODE=require

# --- Sesión, caché y colas: sin servicios externos en hosting compartido ------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log

# --- Configuración propia del proyecto ---------------------------------------
# Los endpoints de hoteles siguen sin exigir token para poder evaluarse desde
# la documentación; el panel web sí exige iniciar sesión.
API_AUTH_ENABLED=false

API_RATE_LIMIT_READ=120
API_RATE_LIMIT_WRITE=40

# Origen exacto del frontend. Sin comodines: es lo que impide que otro sitio
# consuma la API desde el navegador de un usuario.
FRONTEND_URL=https://decameron.<tu-dominio>
CORS_ALLOWED_ORIGINS=https://decameron.<tu-dominio>

# Instancia de demostración: el código 2FA se muestra en pantalla y la
# documentación OpenAPI es pública. En un despliegue real, ambos en false.
TWO_FACTOR_REVEAL_CODE=true
API_DOCS_PUBLIC=true

# Carga hoteles de ejemplo y usuario de prueba al sembrar (instancia de demostración).
DEMO_SEED=true
